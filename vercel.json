{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/subscribe.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/download.ts": {
      "maxDuration": 30,
      "memory": 512,
      "includeFiles": "private/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
