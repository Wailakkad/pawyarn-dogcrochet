# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Free Crochet Dog Sweater Guide — Landing Page Backend
# Set these in Vercel → Project → Settings → Environment Variables.
# They are SERVER-ONLY. Never prefix with VITE_ (that would expose them to the
# browser bundle). Never commit real values — .env* files are git-ignored.
# ---------------------------------------------------------------------------

# GOOGLE_APPS_SCRIPT_URL: The web app URL from Apps Script deployment
# (Deploy → New deployment → Web app → "Execute as: Me" → "Who has access:
# Anyone" → copy the /exec URL). Example:
# https://script.google.com/macros/s/AKfy.../exec
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbxZ_y1BGPkxa9ItH5jJtaCu_MZePm6ALuffyXzvmNpo0lSvyyIc5ZGt73Qs59w8tpr5zg/exec"

# GOOGLE_APPS_SCRIPT_SECRET: A long random secret you generate yourself
# (e.g. `openssl rand -hex 32`). Must EXACTLY match the APPS_SCRIPT_SECRET
# Script Property set inside the Apps Script project. Server-to-server auth
# only — never expose this in frontend code or public env vars.
GOOGLE_APPS_SCRIPT_SECRET="pawyarnemailslistforleads"

# PDF_PRIVATE_PATH: Filesystem path to the private PDF, relative to the
# project root. MUST NOT be inside public/ (that folder is publicly served).
# Default shown here is applied automatically if unset.
PDF_PRIVATE_PATH="private/granny-square-dog-sweater.pdf"

# PUBLIC_SITE_URL: Canonical production URL, used for absolute links/canonicals.
PUBLIC_SITE_URL="https://pawyarn-dogcrochet.vercel.app/"
